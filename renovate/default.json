{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "commitTrailers": [
    "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>"
  ],
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "groupName": "Gradle",
      "matchManagers": [
        "gradle"
      ]
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "org.codehaus.groovy:groovy-bom",
        "org.spockframework:spock-bom"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    }
  ]
}
